#!/usr/bin/env bash
#
# Bashcrawl Binder Post-Build Configuration
# Path: Environment Setup → Terminal Configuration → Game Initialization
#
# This script configures the mybinder.org environment for the Bashcrawl
# educational adventure game, setting up the terminal environment and
# preparing the learning path for new adventurers.

set -euo pipefail

# Path: Environment Validation
validate_binder_environment() {
    # Verify this is running in a Binder environment
    if [ "${USER:-}" != "jovyan" ]; then
        echo "🏰 This script is designed for mybinder.org configuration"
        echo "🔮 It should not be used in other environments"
        echo "⚡ Current user: ${USER:-unknown}"
        exit 0
    fi
    
    echo "🎮 Configuring Bashcrawl environment for user: $USER"
}

# Path: Terminal Configuration
configure_bash_environment() {
    echo "🛡️ Setting up adventurer's terminal environment..."
    
    # Configure the adventurer's shell environment
    cat >> ~/.bashrc << 'EOF'
# Bashcrawl Educational Environment Configuration
# Disable verbose output and non-essential error reporting for cleaner learning
set +x +e

# Set a themed prompt to immerse players in the adventure
export PS1="🏰 bashcrawler\$ "

# Disable colored output for consistent cross-platform experience
alias ls='ls --color=never'

# Initialize game state - empty inventory for new adventurers
export I=""

# Navigate to the entrance chamber to begin the adventure
cd entrance

# Display the welcome message to guide the first steps
cat ../.binder/welcome_message
EOF
    
    echo "✅ Terminal environment configured successfully"
}

# Path: Game Initialization
initialize_game_state() {
    echo "🎲 Initializing game state for new adventure..."
    
    # Ensure proper permissions for game files
    find . -name "treasure" -o -name "potion" -o -name "spell" | while read -r file; do
        if [ -f "$file" ]; then
            chmod +x "$file" 2>/dev/null || true
        fi
    done
    
    echo "🗝️ Game permissions set correctly"
}

# Main execution path
main() {
    echo "🌟 Starting Bashcrawl Binder configuration..."
    
    # Follow the configuration path
    validate_binder_environment
    configure_bash_environment
    initialize_game_state
    
    echo "🎉 Bashcrawl environment ready for adventure!"
    echo "🎯 Players will begin their journey in the entrance chamber"
}

# Execute configuration if running as main script
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi

# Continue with any additional post-build steps
exec "$@"

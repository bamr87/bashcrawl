# This is a configuration file for Git.
# Items listed here are ignored by Git.
.backups

# ============================================================
# Runtime game-state files (created during play, never committed)
# ============================================================

# Unified save file (shared by Bash emulator and Python TUI)
.bashcrawl_save.json

# Legacy save files (kept for migration; superseded by .bashcrawl_save.json)
.ti_save.json
.game_state
.game_history
.game_data/

# ============================================================
# Player-unlocked entrance areas
# These directories start as hidden (e.g. entrance/.chapel/)
# and get renamed to their visible form when a player unlocks
# them. The visible form is transient game state, not source.
# ============================================================
entrance/chapel/
entrance/vault/
entrance/scrap/
entrance/rift/

# Tutorial / player-created directories
entrance/workshop/
workshop/

# ============================================================
# Generated combat / loot artifacts inside entrance/
# ============================================================
entrance/**/corpse.*
entrance/**/.corpse.*.looted
entrance/**/.statue_defeated
entrance/**/treasure
entrance/**/platinum
entrance/**/orb[2-9]

# ============================================================
# Bashcrawl Player Logs (Personal Journey Data)
# ============================================================
logs/player-progress.log
logs/command-history.log
logs/room-visits.log
logs/treasure-collection.log
logs/session-*.log
logs/sessions/
logs/screenshots/
logs/feedback/
logs/learning-notes.txt
logs/temp/
logs/bashcrawl.log
logs/setup.log
logs/live_agent.jsonl
logs/.last_run_meta.json
logs/.last_passing_run.json

# Temporary files
*.tmp
.DS_Store
.game_*

__pycache__
.setup_complete

# Test framework
test/reports/
test/.pytest_cache/
test/.bashcrawl_save.json
test/agent_playtest*
.pytest_cache/
.env

# Generated screenshots metadata
screenshots/manifest_*.json

# Local virtualenv
.venv/

# Node (no packages are installed — zero-dependency policy — but keep
# accidental installs out of git)
node_modules/

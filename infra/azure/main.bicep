// The production host of the web trainer: one Azure Static Web App.
//
// Deployed by infra/azure/bootstrap.sh with parameters.prod.json; the site's
// content is uploaded by .github/workflows/azure-swa.yml (SWA CLI, a prebuilt
// folder). No repository is linked here on purpose: linking one makes Azure
// generate its own token-based workflow, and this pipeline logs in with OIDC.
// Custom domains are not declared here either: Azure validates a domain
// against live DNS, so infra/azure/cutover.sh attaches them once the records
// exist. Runbook: docs/deploy.md.

@description('Azure region of the Static Web App resource. Production content is served from the global edge whatever the region; preview and staging environments are served from this one.')
param location string = 'westus2'

@description('Resource name of the Static Web App. The public hostname is generated by Azure, not derived from this.')
param staticWebAppName string = 'swa-bashcrawl-prod'

@description('Hosting plan. Free: 3 pre-production environments, 2 custom domains, 100 GB of bandwidth a month with no way to buy more, no SLA. Standard: 10 environments, more custom domains, paid bandwidth overage, an SLA. See docs/deploy.md before changing it.')
@allowed([
  'Free'
  'Standard'
])
param sku string = 'Free'

@description('Tags on the Static Web App.')
param tags object = {
  project: 'bashcrawl'
  env: 'prod'
}

resource swa 'Microsoft.Web/staticSites@2023-12-01' = {
  name: staticWebAppName
  location: location
  tags: tags
  sku: {
    name: sku
    tier: sku
  }
  properties: {
    // No linked repository: the deploy workflow uploads a prebuilt folder.
    provider: 'None'
    // staticwebapp.config.json (generated by scripts/write_swa_config.py)
    // carries the headers, cache rules and the 404 override.
    allowConfigFileUpdates: true
    // Pull-request previews and the `staging` environment.
    stagingEnvironmentPolicy: 'Enabled'
  }
}

output staticWebAppName string = swa.name
output defaultHostname string = swa.properties.defaultHostname
output sku string = sku
output resourceId string = swa.id

            "name": "nothing-left-the-site",
            "script": "(async () => {\n  await new Promise((done) => setTimeout(done, 1500));\n  const here = location.origin;\n  const elsewhere = performance.getEntriesByType(\"resource\").map((entry) => entry.name).filter((url) => !url.startsWith(here + \"/\") && !url.startsWith(\"data:\") && !url.startsWith(\"blob:\"));\n  if (elsewhere.length) throw new Error(`${elsewhere.length} request(s) left the site: ${elsewhere.slice(0, 3).join(\" \")}`);\n  const posthog = performance.getEntriesByType(\"resource\").map((entry) => entry.name).filter((url) => /posthog/i.test(url));\n  if (posthog.length) throw new Error(`PostHog code was loaded: ${posthog[0]}`);\n  if (typeof window.posthog !== \"undefined\") throw new Error(\"window.posthog exists\");\n  const keys = Object.keys(localStorage);\n  const stored = keys.filter((key) => /^ph_|posthog|consent/i.test(key));\n  if (stored.length) throw new Error(`analytics storage was written: ${stored.join(\", \")}`);\n  if (document.cookie) throw new Error(`a cookie was set: ${document.cookie.slice(0, 60)}`);\n  const foreign = [...document.querySelectorAll(\"script[src], iframe[src], img[src]\")].map((el) => el.src).filter((src) => src && !src.startsWith(here) && !src.startsWith(\"data:\"));\n  if (foreign.length) throw new Error(`the page embeds ${foreign[0]}`);\n  return { resources: performance.getEntriesByType(\"resource\").length, elsewhere: 0, storageKeys: keys, cookies: document.cookie.length };\n})()\n"

    "permissions": {
      "title": "Quick Reference: File Permissions",
      "sections": [
        {
          "title": "UNDERSTANDING PERMISSIONS",
          "items": [
            {
              "cmd": "drwxrwxrwx",
              "desc": "d=dir, rwx=read/write/exec"
            },
            {
              "cmd": "-rwxr-xr-x",
              "desc": "-=file, 755 permissions"
            },
            {
              "cmd": "First rwx: owner",
              "desc": "Second rwx: group"
            },
            {
              "cmd": "Third rwx: others",
              "desc": "*=executable in ls -F"
            }
          ]
        },
        {
          "title": "COMMON PERMISSION FIXES",
          "items": [
            {
              "cmd": "chmod +x <file>",
              "desc": "Make executable"
            },
            {
              "cmd": "chmod -x <file>",
              "desc": "Remove execute"
            },
            {
              "cmd": "chmod 755 <file>",
              "desc": "rwxr-xr-x"
            },
            {
              "cmd": "chmod 644 <file>",
              "desc": "rw-r--r--"
            },
            {
              "cmd": "ls -la <file>",
              "desc": "Check current perms"
            }
          ]
        },
        {
          "title": "PERMISSION NUMBERS",
          "items": [
            {
              "cmd": "4 = read (r)",
              "desc": "2 = write (w)"
            },
            {
              "cmd": "1 = execute (x)",
              "desc": "0 = no permission"
            },
            {
              "cmd": "7 = 4+2+1 = rwx",
              "desc": "5 = 4+1 = r-x"
            },
            {
              "cmd": "6 = 4+2 = rw-",
              "desc": "3 = 2+1 = -wx"
            }
          ]
        }
      ]
    }

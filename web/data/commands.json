{
  "categories": {
    "navigation": {
      "title": "Navigation",
      "commands": [
        {
          "command": "pwd",
          "description": "Print Working Directory - shows your exact location"
        },
        {
          "command": "ls",
          "description": "List files and directories in current location"
        },
        {
          "command": "ls -F",
          "description": "List with type indicators: * = executable, / = directory, @ = link"
        },
        {
          "command": "ls -la",
          "description": "List ALL files including hidden (.), with permissions and details"
        },
        {
          "command": "ls -lh",
          "description": "List with human-readable file sizes"
        },
        {
          "command": "cd <path>",
          "description": "Change directory to specified path"
        },
        {
          "command": "cd ..",
          "description": "Move up one directory level"
        },
        {
          "command": "cd ~",
          "description": "Go to home directory"
        },
        {
          "command": "cd -",
          "description": "Go back to previous directory"
        }
      ]
    },
    "file_viewing": {
      "title": "File Content Viewing",
      "commands": [
        {
          "command": "cat <file>",
          "description": "Display entire file contents at once"
        },
        {
          "command": "less <file>",
          "description": "View file page by page (Space=next page, b=previous, q=quit)"
        },
        {
          "command": "head <file>",
          "description": "Show first 10 lines of file"
        },
        {
          "command": "head -n 20 <file>",
          "description": "Show first 20 lines of file"
        },
        {
          "command": "tail <file>",
          "description": "Show last 10 lines of file"
        },
        {
          "command": "tail -f <file>",
          "description": "Follow file changes in real-time"
        },
        {
          "command": "wc <file>",
          "description": "Count lines, words, and characters"
        }
      ]
    },
    "file_operations": {
      "title": "File Operations",
      "commands": [
        {
          "command": "cp <source> <dest>",
          "description": "Copy file or directory"
        },
        {
          "command": "mv <source> <dest>",
          "description": "Move/rename file or directory"
        },
        {
          "command": "rm <file>",
          "description": "Delete file (CAREFUL - no undo!)"
        },
        {
          "command": "mkdir <name>",
          "description": "Create new directory"
        },
        {
          "command": "rmdir <name>",
          "description": "Remove empty directory"
        },
        {
          "command": "chmod +x <file>",
          "description": "Make file executable"
        },
        {
          "command": "chmod -x <file>",
          "description": "Remove executable permission"
        }
      ]
    },
    "search": {
      "title": "Search and Find",
      "commands": [
        {
          "command": "find . -name \"*pattern*\"",
          "description": "Find files/directories by name pattern"
        },
        {
          "command": "find . -type f",
          "description": "Find only files"
        },
        {
          "command": "find . -type d",
          "description": "Find only directories"
        },
        {
          "command": "grep \"pattern\" <file>",
          "description": "Search for pattern within file"
        },
        {
          "command": "grep -r \"pattern\" .",
          "description": "Search for pattern in all files recursively"
        },
        {
          "command": "which <command>",
          "description": "Show location of command executable"
        }
      ]
    },

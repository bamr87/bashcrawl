# Bashcrawl environment variables
# Copy this file to .env and fill in your keys

# Required for AI features (Merlin chat, AI tests)
ANTHROPIC_API_KEY=your-key-here

# Claude Code subscription token for the blank-slate playtest (`make playtest`).
# Generate with: claude setup-token   —   paste it as ONE line (no line breaks).
# This file is a committed template; put the real value in .env (gitignored) only.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: xAI / Grok API token (reserved for future use)
XAI_TOKEN=your-token-here

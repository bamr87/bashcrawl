# Bashcrawl environment variables
# Copy this file to .env and fill in your keys

# Required for AI features (Merlin chat, AI tests)
ANTHROPIC_API_KEY=your-key-here

# xAI Grok — used by `make playtest-grok` (never commit .env)
#
# Preferred: OpenCode SuperGrok OAuth in ~/.local/share/opencode/auth.json
#   (automatic after `/connect` → xAI in OpenCode). Optional override:
# XAI_ACCESS_TOKEN=eyJ...   # OAuth access JWT
#
# Console API keys are a different credential (tried last):
# XAI_API_KEY=xai-your-key-here

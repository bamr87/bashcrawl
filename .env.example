# Bashcrawl environment variables
# Copy this file to .env and fill in your keys. Every .env* file but this one
# is gitignored: never commit a real value.

# ── Web trainer build (vite.config.mts reads .env files from the repo root) ──
#
# Vite puts every VITE_* value into the JavaScript the browser downloads, so
# these are public values, never secrets. All are optional for local work: an
# empty value means "off" or "unknown". The deploy workflow
# (.github/workflows/azure-swa.yml) sets them from GitHub Actions repository
# variables of the same names; docs/deploy.md has the list.

# The site's canonical origin: scheme and host, no trailing slash, e.g.
# https://example.com. It is the ONE place the production domain is named.
VITE_SITE_URL=

# PostHog project key (phc_…, public by design). Analytics exists only in a
# build that has one: leave it empty and nothing is measured (docs/analytics.md).
VITE_POSTHOG_KEY=

# Where analytics events are sent: PostHog Cloud (US or EU), or the https
# origin of a reverse proxy in front of it. The deploy adds a proxy's origin
# to the Content-Security-Policy (scripts/write_swa_config.py).
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional: the PostHog app itself, needed only when VITE_POSTHOG_HOST is a
# reverse proxy (for example https://us.posthog.com).
VITE_POSTHOG_UI_HOST=

# Which deployment this build is: production | staging | preview. The deploy
# sets it; leave it empty locally. Anything but production is kept out of
# search indexes.
VITE_APP_ENV=

# ── Agent playtests (Python harness; none of these reach the web build) ──

# Required for AI features (Merlin chat, AI tests)
ANTHROPIC_API_KEY=your-key-here

# xAI Grok — used by `make playtest-grok` (never commit .env)
#
# Preferred: OpenCode SuperGrok OAuth in ~/.local/share/opencode/auth.json
#   (automatic after `/connect` → xAI in OpenCode). Optional override:
# XAI_ACCESS_TOKEN=eyJ...   # OAuth access JWT
#
# Console API keys are a different credential (tried last):
# XAI_API_KEY=xai-your-key-here

{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        // ── Textual TUI with Merlin chat panel ──────────────────────────────
        // Launches the full Textual game. Press F3 to open the chat panel.
        // Set breakpoints in:
        //   ti/ai_chat.py          → AIChatService.ask_streaming / ask_sync
        //   ti/chat_panel.py       → ChatPanel.stream_token / append_ai
        //   ti/app.py              → BashcrawlApp._send_to_merlin
        //   ti/chat_context.py     → GameContextBuilder.build
        //
        // TEXTUAL_LOG captures internal Textual & worker-thread tracebacks to
        // /tmp/textual.log so you can inspect crashes even when the TUI is
        // running full-screen.
        {
            "type": "debugpy",
            "request": "launch",
            "name": "🧙 Debug TUI — Merlin Chat",
            "module": "ti",
            "cwd": "${workspaceFolder}/src/terminal-illness",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src/terminal-illness",
                "TEXTUAL_LOG": "/tmp/textual_debug.log",
                "TEXTUAL_LOG_VERBOSITY": "3"
            },
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "stopOnEntry": false,
            "console": "integratedTerminal"
        },

        // ── Merlin CLI bridge (bash → Python) ──────────────────────────────
        // Directly runs chat_cli.py so you can debug single-turn responses
        // without the Textual TUI. Set breakpoints in:
        //   ti/chat_cli.py         → _run_full()
        //   ti/ai_chat.py          → AIChatService.ask_sync()
        //   ti/chat_context.py     → GameContextBuilder.build()
        {
            "type": "debugpy",
            "request": "launch",
            "name": "🧙 Debug Merlin CLI",
            "module": "ti.chat_cli",
            "args": ["how do I find hidden files?"],
            "cwd": "${workspaceFolder}/src/terminal-illness",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src/terminal-illness"
            },
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "stopOnEntry": false,
            "console": "integratedTerminal"
        },

        // ── AI Chat unit tests ──────────────────────────────────────────────
        // Runs test/unit/test_ai_chat.py under the debugger.
        // Useful for stepping through AIChatService / GameContextBuilder logic
        // with mocked Anthropic responses.
        {
            "type": "debugpy",
            "request": "launch",
            "name": "🧙 Debug AI Chat Tests",
            "module": "pytest",
            "args": [
                "unit/test_ai_chat.py",
                "-v",
                "--tb=long",
                "--no-header",
                "-s"
            ],
            "cwd": "${workspaceFolder}/test",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src/terminal-illness"
            },
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "console": "integratedTerminal"
        },

        // ── Merlin worker thread — exception-break mode ────────────────────
        // Same as the TUI launch but configured to STOP immediately on any
        // raised exception anywhere in the worker thread.
        //
        // HOW TO USE:
        //   1. Select this config in the Run panel and press F5
        //   2. While paused at startup: open the Breakpoints panel (Run view → 
        //      BREAKPOINTS section) and enable "Raised Exceptions" AND
        //      "Uncaught Exceptions" under "Python Exceptions"
        //   3. Resume (F5) — the debugger will now stop at the exact line in
        //      _send_to_merlin (or AIChatService) that crashes the session
        {
            "type": "debugpy",
            "request": "launch",
            "name": "🧙 Debug TUI — Break on Exception",
            "module": "ti",
            "cwd": "${workspaceFolder}/src/terminal-illness",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src/terminal-illness",
                "TEXTUAL_LOG": "/tmp/textual_debug.log",
                "TEXTUAL_LOG_VERBOSITY": "3"
            },
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "stopOnEntry": false,
            "console": "integratedTerminal"
        },

        // ── All unit tests ──────────────────────────────────────────────────
        {
            "type": "debugpy",
            "request": "launch",
            "name": "🧪 Debug All Unit Tests",
            "module": "pytest",
            "args": ["-m", "unit", "--tb=short", "-v", "-s"],
            "cwd": "${workspaceFolder}/test",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src/terminal-illness"
            },
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true,
            "console": "integratedTerminal"
        },

        // ── Docker: debug tests inside container ─────────────────────────
        // Attach to a pytest session running in the test container with
        // debugpy listening on port 5678.
        //
        // HOW TO USE:
        //   1. Start the test container with debugpy:
        //      docker compose run --rm -p 5678:5678 test \
        //        python -m debugpy --listen 0.0.0.0:5678 --wait-for-client \
        //        -m pytest -m unit -v -s
        //   2. Select this config and press F5 to attach
        {
            "type": "debugpy",
            "request": "attach",
            "name": "🐳 Docker: Attach to Tests",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/opt/bashcrawl"
                }
            ],
            "justMyCode": false
        },

        // ── Docker: debug TUI inside container ──────────────────────────
        // Attach to the Textual TUI running with debugpy in a container.
        //
        // HOW TO USE:
        //   1. Start TUI container with debugpy:
        //      docker compose run --rm -p 5678:5678 tui \
        //        python -m debugpy --listen 0.0.0.0:5678 --wait-for-client \
        //        -m ti --game-root /opt/bashcrawl
        //   2. Select this config and press F5 to attach
        {
            "type": "debugpy",
            "request": "attach",
            "name": "🐳 Docker: Attach to TUI",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/opt/bashcrawl"
                }
            ],
            "justMyCode": false
        },

        // ── (Legacy) Node launch ────────────────────────────────────────────
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${file}"
        }
    ]
}
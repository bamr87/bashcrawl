{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        // ── Playtest MCP server ─────────────────────────────────────────────
        // Debug the lean MCP playtest harness (src/playtest/).
        {
            "type": "debugpy",
            "request": "launch",
            "name": "🎲 Debug Playtest MCP Server",
            "module": "playtest.mcp_server",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "BASHCRAWL_ROOT": "${workspaceFolder}"
            },
            "justMyCode": false,
            "console": "integratedTerminal"
        },

        // ── All unit tests ──────────────────────────────────────────────────
        {
            "type": "debugpy",
            "request": "launch",
            "name": "🧪 Debug All Unit Tests",
            "module": "pytest",
            "args": ["-m", "unit", "--tb=short", "-v", "-s"],
            "cwd": "${workspaceFolder}/test",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/test",
                "BASHCRAWL_ROOT": "${workspaceFolder}"
            },
            "justMyCode": true,
            "console": "integratedTerminal"
        }
    ]
}

// ╔═══════════════════════════════════════════════════════════════════════════╗
// ║                 🐳  BASHCRAWL DEV CONTAINER  🐳                         ║
// ║                                                                           ║
// ║  VS Code / GitHub Codespaces development environment                     ║
// ╚═══════════════════════════════════════════════════════════════════════════╝
//
// Usage:
//   1. Install the "Dev Containers" VS Code extension
//   2. Open this repo in VS Code
//   3. Press F1 → "Dev Containers: Reopen in Container"
//
// This provides a fully configured environment with:
//   - Bash + ShellCheck for game scripts
//   - Python 3 + pip for TUI, viewer, and tests
//   - Node.js for markdownlint
//   - Docker-in-Docker for building/running game containers
//   - GitHub Copilot support
{
    "name": "Bashcrawl Development",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

    "features": {
        // Python 3 for TUI, viewer, and tests
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.12"
        },
        // Node.js for markdownlint-cli
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts"
        },
        // Docker-in-Docker for building/running containers
        "ghcr.io/devcontainers/features/docker-in-docker:2": {},
        // GitHub CLI
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },

    // Install system packages
    "postCreateCommand": "bash .devcontainer/post-create.sh",

    "customizations": {
        "vscode": {
            "extensions": [
                // Shell development
                "timonwong.shellcheck",
                "foxundermoon.shell-format",
                "mads-hartmann.bash-ide-vscode",
                // Python development
                "ms-python.python",
                "ms-python.debugpy",
                "ms-python.pylint",
                // Docker
                "ms-azuretools.vscode-docker",
                // AI assistant
                "github.copilot",
                "github.copilot-chat",
                // Markdown
                "DavidAnson.vscode-markdownlint",
                // YAML
                "redhat.vscode-yaml",
                // General
                "EditorConfig.EditorConfig",
                "esbenp.prettier-vscode"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.testing.pytestEnabled": true,
                "python.testing.pytestArgs": [
                    "test",
                    "-m", "not ai and not demo"
                ],
                "shellcheck.enable": true,
                "shellcheck.run": "onSave",
                "files.trimTrailingWhitespace": true,
                "files.insertFinalNewline": true,
                "editor.formatOnSave": true,
                "[shellscript]": {
                    "editor.defaultFormatter": "foxundermoon.shell-format"
                }
            }
        }
    },

    // Forward the viewer port
    "forwardPorts": [5000],
    "portsAttributes": {
        "5000": {
            "label": "Bashcrawl Observatory",
            "onAutoForward": "notify"
        }
    },

    // Run as non-root user
    "remoteUser": "vscode",

    // Mount the workspace
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/bashcrawl,type=bind,consistency=cached",
    "workspaceFolder": "/workspaces/bashcrawl",

    // Environment variables
    "containerEnv": {
        "BASHCRAWL_ROOT": "/workspaces/bashcrawl",
        "PYTHONPATH": "/workspaces/bashcrawl/src/terminal-illness"
    }
}
